# ==========================================
# VK BOT CONFIGURATION
# ==========================================
# Токен группы ВКонтакте (с правами сообщений и управления сообществом)
VK_TOKEN=vk1.a.your_vk_group_token_here

# ID вашей группы ВКонтакте (только положительное число)
VK_GROUP_ID=123456789

# ID беседы для сервисного уведомления о запуске (опционально, > 2000000000)
STARTUP_CHAT_ID=

# ==========================================
# SERVER CONFIGURATION
# ==========================================
# Порт для локального HTTP сервера (healthcheck)
LOCAL_SERVER_PORT=8777
NODE_ENV=development

# ==========================================
# REDIS CACHE (OPTIONAL)
# ==========================================
# Если Redis не запущен, бот безопасно использует встроенный in-memory fallback
REDIS_URL=redis://localhost:6379

# ==========================================
# MYSQL DATABASE (OPTIONAL)
# ==========================================
# Если MySQL не запущена, бот безопасно использует встроенный in-memory fallback
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=vk_bot
DB_PORT=3306
